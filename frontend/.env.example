# Empty (the default below) = same-origin relative API paths (/api/...) --
# correct when this frontend is served behind a reverse proxy that also
# routes /api/ to the backend on the same domain (this project's own
# production nginx config at ai.krrkhan.com does exactly that, avoiding
# CORS entirely). For local dev or an SSH-tunnel setup with the backend
# on a separate port and no reverse proxy in front, set an explicit
# absolute URL instead: http://127.0.0.1:8300
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_ASSISTANT_NAME=DayBook AI
