ASSISTANT_NAME=DayBook AI

# Self-hosted only -- points at a local Ollama daemon, never a cloud API.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Self-hosted speech-to-text (faster-whisper). base.en is the balance
# point for a 2-core CPU box; small.en trades latency/RAM for accuracy.
WHISPER_MODEL_SIZE=base.en

# true = skip Ollama for embeddings and use the dependency-free local
# hashing embedder instead (useful with no Ollama daemon at all, e.g. for
# running the test suite on a machine without it installed).
USE_LOCAL_EMBEDDER=false

MEMORY_DB_PATH=data/daybook_ai.sqlite3
KNOWLEDGE_BASE_DIR=data/knowledge

CORS_ORIGINS=http://localhost:3300

# Daybook API bridge -- kept for a future real Daybook deployment; unused
# while DATABASE_URL below is set (the self-hosted-now path).
DAYBOOK_API_BASE_URL=http://127.0.0.1:3000
DAYBOOK_AI_SECRET=

# Self-hosted Postgres, applied from scripts/init_daybook_db.sql (Daybook's
# own Prisma schema, copied verbatim). This backend reads/writes it
# directly via app/services/daybook_db.py.
#   psql "$DATABASE_URL" -f scripts/init_daybook_db.sql
#   .venv/bin/python scripts/create_daybook_user.py you@example.com
DATABASE_URL=postgresql://daybook_ai:CHANGE_ME@127.0.0.1:5432/daybook

# This backend's own login (independent of Daybook's own account system).
# Generate with: .venv/bin/python scripts/create_admin.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
